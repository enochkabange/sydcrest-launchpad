# Copy to .env for local dev. In production these live in Railway's env vars —
# never in the repo. Rotate JWT_SECRET before the pilot opens (MASTER_PLAN §6).

# --- Supabase ---------------------------------------------------------------
# Project settings → API. The service-role key bypasses Row Level Security and
# is a full-database credential: server-side only, never shipped to a browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth -------------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Claude -----------------------------------------------------------------
# Study Buddy, quiz generation, opportunity research. Apply for Anthropic
# startup credits before launch (MASTER_PLAN §8 — flagged "Immediately").
ANTHROPIC_API_KEY=

# --- WhatsApp (optional; features no-op without it) --------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Hubtel MoMo (optional; not needed before Phase F) ----------------------
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=

# --- Daily.co video (optional; sessions/bookings fall back to a plain
# meet_link text field without it) -------------------------------------------
DAILY_API_KEY=

# --- Server -----------------------------------------------------------------
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
