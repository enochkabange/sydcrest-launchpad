# Copy to .env.local. Local development points at the STAGING Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://wyxeerwocbnqmjjzpgun.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_UtIJ13i1lE0k2CE7w4AA1Q_vnaQTqHc
# Fallback origin for auth email links when no request host is available.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp and SMS nudges (issue #52). All optional: without them nothing is
# sent and the app logs once. Server only; never prefix with NEXT_PUBLIC_.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender numbers in E.164, for example +14155238886 (the Twilio WhatsApp sandbox).
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
# Optional: the exact inbound webhook URL set in Twilio, if it differs from the request host.
TWILIO_WEBHOOK_URL=
# Service role key for the re engagement job and the STOP webhook.
SUPABASE_SECRET_KEY=
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Study Buddy (server only). Leave empty and /api/study-buddy answers 503.
ANTHROPIC_API_KEY=
