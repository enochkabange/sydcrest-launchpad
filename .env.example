# Copy to .env.local. Local development points at the STAGING Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://wyxeerwocbnqmjjzpgun.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_UtIJ13i1lE0k2CE7w4AA1Q_vnaQTqHc
# Fallback origin for auth email links when no request host is available.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Analytics 4 measurement id (G-...). Leave empty to keep Google Analytics off.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server only from here down. Never prefix these with NEXT_PUBLIC.

# Show "Continue with Google" on sign in and sign up. Leave unset until the
# Supabase Google provider is configured (issue #34). Takes effect on deploy.
AUTH_GOOGLE_ENABLED=

# Supabase secret key (bypasses RLS): node content generator writes, the WhatsApp
# re engagement job and the Twilio STOP webhook.
SUPABASE_SECRET_KEY=

# Anthropic API key. Without it Study Buddy answers 503 and the content
# generator only estimates costs.
ANTHROPIC_API_KEY=
# Optional: model for pre generated node content (default claude-sonnet-5-5).
CONTENT_MODEL=

# WhatsApp and SMS nudges (issue #52). All optional: without them nothing is
# sent and the app logs once.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender numbers in E.164, for example +14155238886 (the Twilio WhatsApp sandbox).
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
# Optional: the exact inbound webhook URL set in Twilio, if it differs from the request host.
TWILIO_WEBHOOK_URL=
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Certificates (issue #147). Optional Ed25519 private key (PKCS8 PEM, "\n" for
# new lines; make one with `openssl genpkey -algorithm ed25519`) to also serve
# signed VC JWTs at /verify/<id>/credential.jwt. Without it credentials are
# unsigned and the /verify page is the check. SUPABASE_SECRET_KEY above lets
# issuing store the Open Badges JSON; without it the JSON is built on request.
OPEN_BADGES_SIGNING_KEY=

# Error alerts (#304). All optional; with none set, errors still show on
# /admin/insights/reliability. At most one alert an hour per kind of error.
# Slack incoming webhook for the alerts channel (keep it secret: anyone with it can post).
SLACK_ALERT_WEBHOOK_URL=
# Email alerts: the address to alert, and a Resend API key that can send from mail.sydcrest.com.
ALERT_EMAIL=
RESEND_API_KEY=

# Readiness switches (#336, #337). Both off until the founder approves the
# readiness weights and a fairness review is recorded (docs/readiness.md).
# READINESS_FOR_LEARNERS=on: learners see their readiness (My progress, #337),
# "Why this fits you" on opportunities, and "Suggested for you" ranked by match.
READINESS_FOR_LEARNERS=
# READINESS_FOR_EMPLOYERS=on: the "Share my readiness band" boxes on the apply
# form, My applications and the talent listing, and shared bands on the org
# applicants page and in the talent directory. /admin/matching ignores both.
READINESS_FOR_EMPLOYERS=
